# Google Gemini API key (create at https://aistudio.google.com/apikey)
# Server-side only - never put this key in the Flutter app.
GEMINI_API_KEY=

# AI model for trip generation (configurable). Validated 2026-09-04 with @google/genai@2.16.0:
# - gemini-3.6-flash is stable and verified via live API (models/gemini-3.6-flash, 1M tokens)
# - Older models (gemini-2.0-flash, 2.5-flash, 1.5-flash) now return 404 for new API keys
# Keep configurable via AI_MODEL env var.
AI_MODEL=gemini-3.6-flash

# JWT secret for signing authentication tokens — REQUIRED, no fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_char_string

# MySQL database — REQUIRED (no root/root defaults).
DB_HOST=localhost
DB_PORT=3306
DB_USER=pinmap_user
DB_PASSWORD=change_me
DB_NAME=pinmap
DB_CHARSET=utf8mb4
